rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. users Collection
    // Fields: uid, name, email, role, createdAt
    match /users/{userId} {
      // Users can read/write their own profile; admins can read all
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. addresses Collection
    // Fields: originalAddress, normalizedAddress, latitude, longitude, confidence, status, evidence, processingTime, createdAt
    match /addresses/{addressId} {
      // Anyone authenticated can read (for history) and create
      // Node.js backend will handle most creations with admin SDK
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 3. audit_logs Collection
    // Fields: originalAddress, correctedAddress, reason, timestamp
    match /audit_logs/{logId} {
      // Only backend (via Admin SDK) or Admins can read/write
      allow read: if isAdmin();
      allow write: if false; // Only Admin SDK can write
    }

    // 4. cache Collection
    // Fields: addressHash, latitude, longitude, confidence, createdAt
    match /cache/{cacheId} {
      // Users can read cache to speed up duplicate queries
      allow read: if isAuthenticated();
      allow write: if false; // Only Admin SDK can write to cache
    }
  }
}
